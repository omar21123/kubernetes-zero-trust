# Copier ce fichier en terraform.tfvars pour changer une valeur par défaut.
# terraform.tfvars est ignoré par Git.

# aws_region         = "us-east-1"
# kubernetes_version = "1.35"
# node_instance_type = "t3.medium"
# node_count         = 2

