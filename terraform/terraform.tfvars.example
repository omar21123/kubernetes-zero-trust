# allowed_cidrs = ["203.0.113.10/32", "198.51.100.20/32"]

# Coéquipiers (utilisateurs IAM du même compte) administrateurs du cluster :
# extra_admin_arns = ["arn:aws:iam::123456789012:user/prenom"]
